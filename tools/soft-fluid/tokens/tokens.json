{
  "$schema-note": "Single source of truth for color, material, type and motion. Consumed by scene composers (SVG), the web demo (CSS custom properties + Motion timings) and QA (assertions). Brand lime must stay EXACT.",
  "meta": {
    "name": "mosoo-soft-fluid",
    "version": "1.0.0",
    "canvas": {
      "width": 1600,
      "height": 900
    },
    "safeArea": {
      "note": "Meaning must survive centre crops to 21:9, 4:3 and 1.91:1.",
      "x": 200,
      "y": 108,
      "width": 1200,
      "height": 684
    }
  },
  "color": {
    "brand": {
      "lime": "#84DE02"
    },
    "lime": {
      "100": "#EDFAD9",
      "200": "#D4F3A6",
      "300": "#B5EB67",
      "400": "#9DE535",
      "500": "#84DE02",
      "600": "#6EB605",
      "700": "#578E09",
      "800": "#41670C",
      "900": "#2E430F"
    },
    "stage": {
      "paper": "#F4F3EC",
      "mist": "#DEDFD7",
      "charcoal": "#252824",
      "ink": "#141713"
    },
    "surface": {
      "tile": "#FFFFFC",
      "tileEdge": "#ECEBE3",
      "slab": "#252824",
      "slabRaised": "#30332E",
      "slabLine": "#3D413A",
      "slabBar": "#565B52",
      "slabBarSoft": "#42463F"
    },
    "ink": {
      "strong": "#141713",
      "body": "#2B2F29",
      "muted": "#6C7267",
      "faint": "#9CA296",
      "onDark": "#F1F2EA",
      "onDarkMuted": "#A9AEA2"
    }
  },
  "material": {
    "bloom": {
      "blur": {
        "halo": 70,
        "body": 34,
        "core": 18
      },
      "displace": {
        "baseFrequency": 0.0058,
        "octaves": 3,
        "scale": 150
      },
      "density": {
        "halo": {
          "gain": 1.6,
          "bias": -0.02
        },
        "body": {
          "gain": 2.3,
          "bias": -0.36
        },
        "core": {
          "gain": 2.6,
          "bias": -0.58
        }
      },
      "opacity": {
        "halo": 0.62,
        "body": 0.95,
        "core": 0.95
      },
      "darkStrength": 0.6
    },
    "grain": {
      "baseFrequency": 0.82,
      "octaves": 2,
      "lightOpacity": 0.07,
      "darkOpacity": 0.16
    },
    "tile": {
      "radiusRatio": 0.3,
      "shadow": [
        {
          "dy": 26,
          "blur": 30,
          "opacity": 0.2
        },
        {
          "dy": 6,
          "blur": 7,
          "opacity": 0.12
        }
      ]
    },
    "slab": {
      "radius": 26,
      "hairline": 0.09
    },
    "connector": {
      "width": 2.25,
      "dot": 5,
      "dash": "2 9"
    }
  },
  "type": {
    "display": {
      "family": "Newsreader",
      "fallback": "Georgia, 'Times New Roman', serif",
      "weights": [
        400,
        500
      ],
      "file": "newsreader"
    },
    "sans": {
      "family": "Geist Sans",
      "cssFamily": "Geist",
      "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "weights": [
        400,
        500,
        600
      ],
      "file": "geist-sans"
    },
    "mono": {
      "family": "Geist Mono",
      "fallback": "ui-monospace, 'SF Mono', Menlo, monospace",
      "weights": [
        400,
        500
      ],
      "file": "geist-mono"
    },
    "scale": {
      "node": 25,
      "nodeSub": 17.5,
      "tag": 14.5,
      "title": 40,
      "note": 16.5
    },
    "hand": {
      "family": "Shantell Sans",
      "fallback": "cursive",
      "weights": [
        500
      ],
      "file": "shantell-sans"
    }
  },
  "motion": {
    "ease": {
      "out": [
        0.23,
        1,
        0.32,
        1
      ],
      "inOut": [
        0.77,
        0,
        0.175,
        1
      ],
      "drawer": [
        0.32,
        0.72,
        0,
        1
      ]
    },
    "architecture": {
      "hopMs": 600,
      "overlapMs": 120,
      "settleMs": 840,
      "totalMs": 4800,
      "pulseMs": 600
    },
    "persistence": {
      "fadeMs": 220,
      "holdMs": 800,
      "shiftPx": 12
    },
    "channels": {
      "travelMs": 500,
      "staggerMs": 80
    },
    "press": {
      "scale": 0.98,
      "ms": 120
    },
    "reduced": {
      "fadeMs": 120
    }
  }
}
