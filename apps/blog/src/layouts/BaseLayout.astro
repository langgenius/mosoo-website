---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { MOTION_VARIANT } from "../lib/motion";

type HreflangAlternates = Partial<Record<"en" | "zh-CN" | "ja" | "x-default", string>>;

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  author?: string;
  lang?: "en" | "zh-CN" | "ja";
  hreflang?: HreflangAlternates;
  robots?: string;
}
const {
  title,
  description,
  canonical,
  ogImage,
  ogImageAlt = "mosoo open-source agent runtime",
  type = "website",
  publishedTime,
  author,
  lang = "en",
  hreflang,
  robots = "index, follow, max-image-preview:large",
} = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ?? new URL("/landing/invoke-gradient.jpg", Astro.site).href;
const hreflangEntries = (hreflang ? Object.entries(hreflang) : []).filter(
  (entry): entry is [string, string] => Boolean(entry[1]),
);
const ogLocaleByLanguage = { en: "en_US", "zh-CN": "zh_CN", ja: "ja_JP" } as const;
const ogLocale = ogLocaleByLanguage[lang];
const ogLocaleByHreflang: Record<string, (typeof ogLocaleByLanguage)[keyof typeof ogLocaleByLanguage]> = {
  en: "en_US",
  "zh-CN": "zh_CN",
  ja: "ja_JP",
};
const alternateOgLocales = [
  ...new Set(
    hreflangEntries
      .map(([code]) => ogLocaleByHreflang[code])
      .filter((locale) => locale && locale !== ogLocale),
  ),
];
---

<!doctype html>
<html lang={lang} data-motion={MOTION_VARIANT}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    {
      hreflangEntries.map(([code, href]) => (
        <link rel="alternate" hreflang={code} href={new URL(href, Astro.site).href} />
      ))
    }
    <link rel="icon" type="image/svg+xml" href="/blog/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="mosoo blog"
      href="/blog/rss.xml"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="mosoo" />
    <meta property="og:locale" content={ogLocale} />
    {alternateOgLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mosooagent" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {type === "article" && author && <meta property="article:author" content={author} />}
    <script is:inline>
      // Runs before first paint: mark JS as available (entrance-motion CSS is
      // gated on html.js so content is never hidden without a script to
      // reveal it) and honor a `?motion=` preview override.
      document.documentElement.classList.add("js");
      var m = new URLSearchParams(location.search).get("motion");
      if (m === "none" || m === "fade" || m === "rise") {
        document.documentElement.dataset.motion = m;
      }
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-[color:var(--paper)] text-[color:var(--ink-900)]">
    <Header />
    <slot />
    <Footer />
    <script>
      // "rise" variant: reveal [data-reveal] blocks as they enter the
      // viewport. Everything above the fold reveals immediately (with the
      // per-element stagger from --reveal-i); below-fold blocks animate in
      // on scroll. Other variants — and reduced motion — reveal everything
      // at once so no content stays hidden.
      const root = document.documentElement;
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (root.dataset.motion === "rise" && !reduced && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add("is-revealed"));
      }
    </script>
  </body>
</html>
