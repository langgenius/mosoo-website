---
import BaseLayout from "./BaseLayout.astro";
import CardVisual from "../components/CardVisual.astro";
import { getIndexHref, getPostLocale, type Locale } from "../lib/i18n";
import type { CollectionEntry } from "astro:content";

type HreflangAlternates = Partial<Record<"en" | "zh-CN" | "ja" | "x-default", string>>;

interface Props {
  post: CollectionEntry<"blog">;
  hreflang?: HreflangAlternates;
}
const { post, hreflang } = Astro.props;
const {
  title,
  titleAccent,
  description,
  date,
  category,
  author,
  authorAvatar,
  coAuthors,
  heroImage,
  heroAlt,
} = post.data;
const bylineAuthors = [{ name: author, avatar: authorAvatar }, ...coAuthors];
const bylineNames = bylineAuthors.map((a) => a.name).join(" & ");
const accentIndex = titleAccent ? title.indexOf(titleAccent) : -1;
const hasTitleAccent = Boolean(titleAccent && accentIndex >= 0);
const titleBefore = hasTitleAccent ? title.slice(0, accentIndex) : title;
const titleAfter =
  hasTitleAccent && titleAccent
    ? title.slice(accentIndex + titleAccent.length)
    : "";
const locale = getPostLocale(post);
const langTags: Record<Locale, "en" | "zh-CN" | "ja"> = { en: "en", zh: "zh-CN", ja: "ja" };
const lang = langTags[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const indexHref = getIndexHref(locale, base);
const copyByLocale: Record<Locale, { back: string; more: string }> = {
  en: { back: "← All posts", more: "← More posts" },
  zh: { back: "← 返回全部文章", more: "← 更多文章" },
  ja: { back: "← 記事一覧に戻る", more: "← ほかの記事" },
};
const copy = {
  ...copyByLocale[locale],
  by: "By",
  learnMore: "Learn More →",
};
const dateLocales: Record<Locale, string> = { en: "en-US", zh: "zh-CN", ja: "ja-JP" };
const dateLabel = date.toLocaleDateString(dateLocales[locale], {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const canonicalUrl = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  inLanguage: lang,
  ...(heroImage
    ? { image: new URL(heroImage, Astro.site).href }
    : {}),
  author: bylineAuthors.map((a) => ({ "@type": "Person", name: a.name })),
  publisher: { "@id": "https://mosoo.ai/#organization" },
  mainEntityOfPage: canonicalUrl,
  isPartOf: { "@type": "Blog", "@id": "https://mosoo.ai/blog#blog" },
  url: canonicalUrl,
};
---

<BaseLayout
  title={`${title} · mosoo blog`}
  description={description}
  type="article"
  publishedTime={date}
  author={author}
  ogImage={heroImage ? new URL(heroImage, Astro.site).href : undefined}
  ogImageAlt={heroAlt ?? title}
  lang={lang}
  hreflang={hreflang}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
    slot="head"
  />

  <article class="mx-auto w-full max-w-[760px] px-6 py-14 md:py-20" data-page>
    <header data-reveal style="--reveal-i: 0">
      <a
        href={indexHref}
        class="mb-10 inline-block text-[13px] font-medium text-[color:var(--fg-muted)] transition-colors duration-150 hover:text-[color:var(--fg)]"
      >
        {copy.back}
      </a>

      <div class="mb-4 flex items-center gap-2 text-[13px] text-[color:var(--fg-muted)]">
        <span class="font-semibold text-[color:var(--accent-text)]">{category}</span>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{dateLabel}</time>
      </div>

      <h1 class="mb-8 font-display text-[40px] font-medium leading-[1.08] tracking-[-0.022em] text-[color:var(--ink-950)] md:text-[52px]">
        {
          hasTitleAccent && titleAccent ? (
            <>
              {titleBefore}<span class="text-[color:var(--accent-text)]">{titleAccent}</span>{titleAfter}
            </>
          ) : (
            title
          )
        }
      </h1>

      <div class="mb-12 flex items-center gap-3 text-[14px] text-[color:var(--fg-secondary)]">
        <span class="flex -space-x-2">
          {
            bylineAuthors.map((a) => (
              <span class="inline-flex h-9 w-9 items-center justify-center overflow-hidden rounded-full border border-[color:var(--border)] bg-white shadow-[var(--shadow-xs)]">
                {a.avatar ? (
                  <img
                    src={a.avatar}
                    alt={a.name}
                    width="36"
                    height="36"
                    class="h-9 w-9 object-cover"
                  />
                ) : (
                  <img
                    src="/blog/favicon.svg"
                    alt=""
                    width="28"
                    height="28"
                    class="h-7 w-7"
                  />
                )}
              </span>
            ))
          }
        </span>
        <span>{copy.by} {bylineNames}</span>
      </div>
    </header>

    <div
      class="mb-14 overflow-hidden rounded-[var(--r-xl)] border border-[color:var(--border)]"
      data-reveal
      style="--reveal-i: 1"
    >
      <CardVisual
        slug={post.id}
        heroImage={heroImage}
        heroAlt={heroAlt ?? title}
        ratio="16/9"
      />
    </div>

    <div class="prose-mosoo" data-reveal style="--reveal-i: 2">
      <slot />
    </div>

    <hr class="my-16 border-[color:var(--border)]" />

    <div class="flex items-center justify-between text-[14px]">
      <a
        href={indexHref}
        class="font-medium text-[color:var(--fg-secondary)] transition-colors duration-150 hover:text-[color:var(--fg)]"
        >{copy.more}</a
      >
      <a
        href="https://github.com/langgenius/mosoo"
        class="inline-flex items-center gap-2 rounded-[var(--r-md)] bg-[color:var(--green-500)] px-3.5 py-2 font-semibold text-[color:var(--fg-on-accent)] transition-colors duration-150 hover:bg-[color:var(--green-600)]"
        >{copy.learnMore}</a
      >
    </div>
  </article>
</BaseLayout>
