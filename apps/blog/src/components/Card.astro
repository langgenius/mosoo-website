---
// An index card (v5): Intent's feature-card anatomy on the v5 tokens. Styles: src/styles/index-cards.css.
//   media    the post's cover, cropped to 11:8 (the lead card: 16:9 beside its text on wide screens)
//   title    `cardTitle ?? title`, one serif line where the slot allows; the title's link covers the card
//   desc     `description` in full, `descriptionEmphasis` (a phrase from it) in bold
//   meta     category · date, at the foot
// The cover is decorative here: the title beside it names the link. Play / pause stays outside the link.
import type { CollectionEntry } from "astro:content";
import CardVisual from "./CardVisual.astro";
import CoverControls from "./CoverControls.astro";
import { getCover } from "../covers/registry";
import { cardCoverFocus } from "../covers/card-focus";
import { draftLabel } from "../lib/drafts";
import { categoryLabel, dateLocaleByLocale } from "../lib/copy.mjs";

interface Props {
  post: CollectionEntry<"blog">;
  href: string;
  locale?: "en" | "zh" | "ja";
  variant?: "grid" | "lead";
}
const { post, href, locale = "en", variant = "grid" } = Astro.props;
const { title, cardTitle, description, descriptionEmphasis, category, date, heroImage, heroCover, draft } = post.data;
const lead = variant === "lead";
const liveCover = getCover(heroCover);
const coverUid = `cover-${variant}-${post.id}`;
const coverFocus = liveCover ? `--cover-focus: ${+(cardCoverFocus(liveCover.id) * 100).toFixed(2)}%` : undefined;
const dateLabel = date.toLocaleDateString(dateLocaleByLocale[locale] ?? "en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const emphasisAt = descriptionEmphasis ? description.indexOf(descriptionEmphasis) : -1;
const descBefore = emphasisAt >= 0 ? description.slice(0, emphasisAt) : description;
const descAfter = emphasisAt >= 0 && descriptionEmphasis ? description.slice(emphasisAt + descriptionEmphasis.length) : "";
const TitleTag = lead ? "h2" : "h3";
---

<article
  class:list={["bc cv-card", lead && "bc--lead"]}
  data-card={lead ? undefined : ""}
  data-category={category}
  data-rise="card"
  data-cover-zone={liveCover ? "" : undefined}
  style={coverFocus}
>
  <div class="bc-media">
    <CardVisual
      slug={post.id}
      heroImage={heroImage}
      heroAlt=""
      heroCover={heroCover}
      coverUid={coverUid}
      eager={lead}
      label={draft ? draftLabel[locale] : undefined}
      ratio="fill"
    />
  </div>
  <TitleTag class="bc-title"><a class="bc-link" href={href}>{cardTitle ?? title}</a></TitleTag>
  <p class="bc-desc" data-card-desc>
    {descBefore}{emphasisAt >= 0 && <strong>{descriptionEmphasis}</strong>}{descAfter}
  </p>
  <p class="bc-meta" data-card-meta>
    <span class="bc-category">{categoryLabel(locale, category)}</span>
    <span aria-hidden="true">·</span>
    <time datetime={date.toISOString()}>{dateLabel}</time>
  </p>
  {liveCover && <CoverControls cover={liveCover.id} uid={coverUid} locale={locale} compact class="bc-controls" />}
</article>
