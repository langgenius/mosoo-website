---
import CardVisual from "./CardVisual.astro";
import { categoryLabel, dateLocaleByLocale } from "../lib/copy.mjs";

interface Props {
  href: string;
  title: string;
  category: string;
  date: Date;
  locale?: "en" | "zh" | "ja";
  description?: string | undefined;
  slug: string;
  heroImage?: string | undefined;
  heroAlt?: string | undefined;
}
const { href, title, category, date, locale = "en", description, slug, heroImage, heroAlt } = Astro.props;
const dateLabel = date.toLocaleDateString(dateLocaleByLocale[locale] ?? "en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const displayCategory = categoryLabel(locale, category);
---

<a href={href} class="group flex flex-col gap-4">
  <div class="overflow-hidden rounded-[var(--r-lg)] border border-[color:var(--border)]">
    <CardVisual slug={slug} heroImage={heroImage} heroAlt={heroAlt} ratio="16/9" />
  </div>
  <div class="flex min-w-0 flex-1 flex-col gap-2">
    <div class="flex items-center gap-2 text-[13px] text-[color:var(--fg-muted)]">
      <span class="font-semibold text-[color:var(--accent-text)]">{displayCategory}</span>
      <span aria-hidden="true">·</span>
      <time datetime={date.toISOString()}>{dateLabel}</time>
    </div>
    <h3 class="font-display text-[19px] font-medium leading-[1.3] tracking-[-0.015em] text-[color:var(--ink-950)] underline decoration-transparent decoration-2 underline-offset-4 transition-[text-decoration-color] duration-200 group-hover:decoration-[color:var(--green-500)]">
      {title}
    </h3>
    {
      description && (
        <p class="text-[14px] leading-[1.6] text-[color:var(--fg-secondary)] line-clamp-2">
          {description}
        </p>
      )
    }
  </div>
</a>
