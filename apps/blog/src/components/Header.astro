---
import { getIndexHref, getLocaleOptions, type Locale } from "../lib/i18n";
import { headerCopyByLocale } from "../lib/copy.mjs";

interface Props {
  availableLocales?: Locale[];
}

const { availableLocales } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const localeOptions = getLocaleOptions(Astro.url.pathname, base).filter(
  ({ locale }) => !availableLocales || availableLocales.includes(locale),
);
const currentLocale = localeOptions.find(({ active }) => active)?.locale ?? "en";
const blogHref = getIndexHref(currentLocale, base);
const landingHref = `/${currentLocale}`;
const copy = headerCopyByLocale[currentLocale] ?? headerCopyByLocale.en;
---

<header class="sticky top-0 z-20 border-b border-[color:var(--border)] bg-[color:var(--paper)]/85 backdrop-blur-md">
  <div class="mx-auto flex w-full max-w-[1180px] items-center justify-between gap-6 px-7 py-3.5">
    <div class="flex items-center gap-3 text-[color:var(--fg)]">
      <a href={landingHref} aria-label="mosoo home">
        <img src={`${base}/brand-wordmark.svg`} alt="mosoo" class="h-5 w-auto" />
      </a>
      <span class="text-[color:var(--ink-300)]">/</span>
      <a
        href={blogHref}
        class="text-[14.5px] font-medium tracking-[-0.01em] text-[color:var(--ink-900)] transition-colors duration-150 hover:text-[color:var(--accent-text)]"
      >
        {copy.blog}
      </a>
    </div>
    <nav class="flex items-center gap-6 text-[14px] text-[color:var(--fg-secondary)]">
      <a href={landingHref} class="hidden font-medium transition-colors duration-150 hover:text-[color:var(--fg)] sm:inline">{copy.backToMosoo}</a>
      <a
        href={`${base}/rss.xml`}
        class="hidden font-medium transition-colors duration-150 hover:text-[color:var(--fg)] sm:inline"
        title={copy.rssTitle}
        >RSS</a
      >
      <div
        class="flex items-center overflow-hidden rounded-[var(--r-sm)] border border-[color:var(--border)] font-mono text-[12px] font-semibold uppercase tracking-[0.08em]"
        aria-label={copy.languageLabel}
      >
        {
          localeOptions.map((option) => (
            <a
              href={option.href}
              aria-current={option.active ? "true" : undefined}
              class:list={[
                "px-2.5 py-1 transition-colors",
                option.active
                  ? "bg-[color:var(--ink-900)] text-white"
                  : "text-[color:var(--fg-secondary)] hover:bg-[color:var(--ink-50)] hover:text-[color:var(--fg)]",
              ]}
            >
              {option.label}
            </a>
          ))
        }
      </div>
      <a
        href="https://github.com/langgenius/mosoo"
        class="inline-flex items-center gap-2 rounded-[var(--r-md)] bg-[color:var(--ink-900)] px-3.5 py-2 text-[14px] font-semibold tracking-[-0.01em] text-white transition-colors hover:bg-[color:var(--ink-800)]"
      >
        {copy.learnMore}
      </a>
    </nav>
  </div>
</header>
