---
import { getIndexHref, getLocaleOptions, type Locale } from "../lib/i18n";
import { headerCopyByLocale } from "../lib/copy.mjs";

interface Props {
  availableLocales?: Locale[];
}

const { availableLocales } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const localeOptions = getLocaleOptions(Astro.url.pathname, base).filter(
  ({ locale }) => !availableLocales || availableLocales.includes(locale),
);
const currentLocale = localeOptions.find(({ active }) => active)?.locale ?? "en";
const blogHref = getIndexHref(currentLocale, base);
const landingHref = `/${currentLocale}`;
const copy = headerCopyByLocale[currentLocale] ?? headerCopyByLocale.en;
// The home's chrome (staging v5 design review P1-4): the ink lockup of the v5 nav (the landing's generated
// public/brand/v5/logo-nav.svg, served from the site root next to the blog) and its one lime CTA, "Try mosoo".
---

<header class="sticky top-0 z-20 border-b border-[color:var(--border)] bg-[color:var(--blog-bg)]/85 backdrop-blur-md">
  <div class="blog-wrap flex flex-wrap items-center justify-between gap-3 py-3.5 sm:flex-nowrap sm:gap-6">
    <div class="flex shrink-0 items-center gap-3 whitespace-nowrap text-[color:var(--fg)]">
      <a href={landingHref} aria-label="mosoo home">
        <img src="/brand/v5/logo-nav.svg" alt="mosoo" width="93" height="20" class="h-5 w-auto" />
      </a>
      <span class="text-[color:var(--ink-300)]">/</span>
      <a
        href={blogHref}
        class="text-[14.5px] font-medium tracking-[-0.01em] text-[color:var(--v5-ink-2)] transition-colors duration-150 hover:text-[color:var(--v5-ink)]"
      >
        {copy.blog}
      </a>
    </div>
    <nav class="ml-auto flex items-center gap-3 text-[14px] text-[color:var(--fg-secondary)] sm:gap-6">
      <a href={landingHref} class="hidden font-medium transition-colors duration-150 hover:text-[color:var(--fg)] sm:inline">{copy.backToMosoo}</a>
      <a
        href={`${base}/rss.xml`}
        class="hidden font-medium transition-colors duration-150 hover:text-[color:var(--fg)] sm:inline"
        title={copy.rssTitle}
        >RSS</a
      >
      <div
        class="flex shrink-0 items-center overflow-hidden whitespace-nowrap rounded-[var(--r-sm)] border border-[color:var(--border)] text-[13px] font-medium"
        aria-label={copy.languageLabel}
      >
        {
          localeOptions.map((option) => (
            <a
              href={option.href}
              aria-current={option.active ? "true" : undefined}
              class:list={[
                "px-2.5 py-1 transition-colors",
                option.active
                  ? "bg-[color:var(--ink-900)] text-white"
                  : "text-[color:var(--fg-secondary)] hover:bg-[color:var(--ink-50)] hover:text-[color:var(--fg)]",
              ]}
            >
              {option.label}
            </a>
          ))
        }
      </div>
      <a
        href="https://cloud.mosoo.ai"
        class="hidden h-9 items-center whitespace-nowrap rounded-[8px] bg-[#bcf870] px-4 text-[14.5px] font-medium tracking-[-0.005em] text-[color:var(--v5-ink)] transition-colors duration-150 hover:bg-[#d6fba6] sm:inline-flex"
      >
        {copy.tryMosoo}
      </a>
    </nav>
  </div>
</header>
