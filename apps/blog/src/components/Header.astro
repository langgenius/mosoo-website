---
import { getIndexHref, getLocaleOptions, localeNames, navCopyByLocale, type Locale } from "../lib/i18n";
import { headerCopyByLocale } from "../lib/copy.mjs";
// The mark on the mosoo tile: the v5 mark's own geometry, generated for the landing (as the home's panel draws it).
import { BRAND_MARK } from "../../../landing/src/shared/ui/brand-v5.generated.ts";

interface Props {
  availableLocales?: Locale[];
}

const { availableLocales } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const localeOptions = getLocaleOptions(Astro.url.pathname, base).filter(
  ({ locale }) => !availableLocales || availableLocales.includes(locale),
);
const currentOption = localeOptions.find(({ active }) => active);
const currentLocale = currentOption?.locale ?? "en";
const blogHref = getIndexHref(currentLocale, base);
const landingHref = `/${currentLocale}`;
const copy = headerCopyByLocale[currentLocale] ?? headerCopyByLocale.en;
const nav = navCopyByLocale[currentLocale];
const langTags: Record<Locale, string> = { en: "en", zh: "zh-CN", ja: "ja" };
// A post without translations has nothing to switch to, so the switch only shows with two or more languages.
const showLanguages = localeOptions.length > 1;
const products = [
  { id: "mosoo", href: "https://cloud.mosoo.ai", ...nav.mosoo, fresh: false },
  { id: "computer", href: "https://computer.mosoo.ai", ...nav.computer, fresh: true },
] as const;
// The home's chrome (staging v5 design review P1-4): the ink lockup of the v5 nav (the landing's generated
// public/brand/v5/logo-nav.svg, served from the site root next to the blog) and its one lime CTA, "Try mosoo".
// The right side is the home bar's (owner 2026-10-20 17:15; staging v5/polish/nav/DESIGN.md §2, §7;
// apps/landing/src/home/sections/nav.ts): Products ▾ and the language ▾ are buttons with native popovers (popover +
// popovertarget: they open, close on a click outside and on Esc with no script) holding real links, the two products
// and this page in each language it has. Up to 860px the whole <nav> is itself the popover the menu button opens, a
// sheet under the bar with the panels inline and the CTA last, so every link is in the HTML once.
---

<header
  class="sticky top-0 z-20 border-b border-[color:var(--border)] bg-[color:var(--blog-bg)]/85 backdrop-blur-md bn"
  data-blog-nav
>
  <div class="blog-wrap bn-in">
    <div class="bn-brand">
      <a href={landingHref} aria-label={nav.home} class="bn-home">
        <img src="/brand/v5/logo-nav.svg" alt="mosoo" width="93" height="20" class="h-5 w-auto" />
      </a>
      <span class="bn-sep" aria-hidden="true">/</span>
      <a href={blogHref} class="bn-blog">{copy.blog}</a>
    </div>
    <div class="bn-end">
      <nav class="bn-row" id="bn-menu" aria-label={nav.label} popover>
        <div class="bn-dd bn-dd--products">
          <button type="button" class="bn-tg" popovertarget="bn-products">
            {nav.products}
            <svg
              class="bn-chev"
              viewBox="0 0 10 6"
              width="10"
              height="6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"><path d="M1 1l4 4 4-4"></path></svg
            >
          </button>
          <div class="bn-pop bn-pop--products" id="bn-products" popover>
            <p class="bn-pop-h" id="bn-products-h">{nav.products}</p>
            <ul class="bn-prods" aria-labelledby="bn-products-h">
              {
                products.map((product) => (
                  <li>
                    {/* The spaces between the parts are the link's text (it reads "mosoo Open-source …"); the grid
                        drops them from the layout. */}
                    <a class="bn-prod" href={product.href}>
                      <span class="bn-tile" aria-hidden="true">
                        {product.id === "mosoo" ? (
                          <svg
                            class="bn-tile-g"
                            viewBox={BRAND_MARK.vb.join(" ")}
                            fill="currentColor"
                            focusable="false"
                          >
                            <path d={BRAND_MARK.fill} />
                            <path d={BRAND_MARK.bar} fill="none" stroke="currentColor" stroke-width={BRAND_MARK.stroke} />
                          </svg>
                        ) : (
                          <svg
                            class="bn-tile-g"
                            viewBox="0 0 12 12"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            focusable="false"
                          >
                            <rect x="1.1" y="1.6" width="9.8" height="6.6" rx="1.2" />
                            <path d="M6 8.2v2.2M3.6 10.4h4.8" />
                          </svg>
                        )}
                      </span>{" "}
                      <span class="bn-prod-name">
                        <span translate="no">{product.name}</span>
                        {product.fresh && (
                          <>
                            {" "}
                            <span class="bn-new">{nav.new}</span>
                          </>
                        )}
                      </span>{" "}
                      <span class="bn-prod-line">{product.line}</span>{" "}
                      <span class="bn-prod-host" translate="no">
                        {new URL(product.href).host}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <a href={landingHref} class="bn-a">{copy.backToMosoo}</a>
        <a href={`${base}/rss.xml`} class="bn-a" title={copy.rssTitle}>RSS</a>
        {
          showLanguages && (
            <div class="bn-dd bn-dd--lang">
              <button
                type="button"
                class="bn-tg"
                popovertarget="bn-lang"
                aria-label={nav.languageButton.replace("{lang}", currentOption?.label ?? "")}
              >
                <svg
                  class="bn-globe"
                  viewBox="0 0 16 16"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.2"
                  aria-hidden="true"
                  focusable="false"
                >
                  <circle cx="8" cy="8" r="6.4" />
                  <path d="M1.6 8h12.8M8 1.6c1.7 1.8 2.6 4 2.6 6.4S9.7 12.6 8 14.4C6.3 12.6 5.4 10.4 5.4 8S6.3 3.4 8 1.6z" />
                </svg>
                <span>{currentOption?.label}</span>
                <svg
                  class="bn-chev"
                  viewBox="0 0 10 6"
                  width="10"
                  height="6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M1 1l4 4 4-4" />
                </svg>
              </button>
              <div class="bn-pop bn-pop--lang" id="bn-lang" popover>
                <p class="bn-pop-h" id="bn-lang-h">
                  <svg
                    class="bn-globe"
                    viewBox="0 0 16 16"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.2"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <circle cx="8" cy="8" r="6.4" />
                    <path d="M1.6 8h12.8M8 1.6c1.7 1.8 2.6 4 2.6 6.4S9.7 12.6 8 14.4C6.3 12.6 5.4 10.4 5.4 8S6.3 3.4 8 1.6z" />
                  </svg>
                  <span>{nav.language}</span>
                </p>
                <ul class="bn-langs" aria-labelledby="bn-lang-h">
                  {localeOptions.map((option) => (
                    <li>
                      <a
                        href={option.href}
                        hreflang={langTags[option.locale]}
                        lang={langTags[option.locale]}
                        data-locale={option.locale}
                        aria-current={option.active ? "true" : undefined}
                      >
                        <svg
                          class="bn-check"
                          viewBox="0 0 12 12"
                          width="12"
                          height="12"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <path d="M2.5 6.2l2.3 2.3 4.7-5" />
                        </svg>
                        <span>{localeNames[option.locale]}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )
        }
        <a href="https://cloud.mosoo.ai" class="bn-cta">{copy.tryMosoo}</a>
      </nav>
      <button type="button" class="bn-menu" popovertarget="bn-menu" aria-label={nav.menu}>
        <svg
          class="bn-burger"
          viewBox="0 0 18 18"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <path class="bn-burger-a" d="M2 6.25h14"></path>
          <path class="bn-burger-b" d="M2 11.75h14"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // What the browser does not do for the popovers, as the home's nav engine does it (apps/landing/src/effects/v5/
  // nav.ts): close an open panel, or the phone sheet, once focus lands outside it and its button (WCAG 2.4.11), and
  // once its button is no longer shown (a tablet turned to landscape with the sheet open); focusin, not focusout, so
  // closing never sends focus back to the button. And remember the language a reader picks, as the landing does (the
  // worker's "/" redirect reads mosoo_locale before Accept-Language). Without JS the menus still open, close and link.
  const bar = document.querySelector<HTMLElement>("[data-blog-nav]");
  if (bar) {
    const popovers = [...bar.querySelectorAll<HTMLElement>("[popover]")].map((panel) => ({
      panel,
      button: bar.querySelector(`[popovertarget="${CSS.escape(panel.id)}"]`),
    }));
    document.addEventListener("focusin", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      for (const { panel, button } of popovers) {
        if (panel.matches(":popover-open") && !panel.contains(target) && !button?.contains(target)) panel.hidePopover();
      }
    });
    window.addEventListener(
      "resize",
      () => {
        for (const { panel, button } of popovers) {
          if (panel.matches(":popover-open") && button && button.getClientRects().length === 0) panel.hidePopover();
        }
      },
      { passive: true },
    );
    bar.addEventListener("click", (event) => {
      const link = event.target instanceof Element ? event.target.closest("[data-locale]") : null;
      const code = link?.getAttribute("data-locale");
      if (code === "en" || code === "zh" || code === "ja") {
        document.cookie = `mosoo_locale=${code}; Path=/; Max-Age=31536000; SameSite=Lax; Secure`;
      }
    });
  }
</script>

<style>
  /* The home bar's look (apps/landing/src/home/sections/nav.css; the subpages' shared/styles/site-nav.css carries the
     same values) on the blog's sticky glass header: links and triggers in Hanken 500 14.5 ink-2, panels as paper
     cards 8px under the bar, from their trigger by CSS anchor positioning (without it: under the bar's right end). */
  .bn {
    --bn-gap: 24px;
    --bn-h: 64px;
    --bn-lime: #bcf870;
    --bn-ease: cubic-bezier(0, 0, 0.2, 1);
    --bn-ease-theme: cubic-bezier(0.4, 0, 0.2, 1);
    anchor-name: --bn-bar;
  }

  .bn-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--bn-gap);
    height: var(--bn-h);
  }

  .bn-brand {
    display: flex;
    flex: none;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
  }

  .bn-home {
    display: block;
    color: var(--fg);
  }

  .bn-sep {
    color: var(--ink-300);
  }

  .bn-blog {
    color: var(--v5-ink-2);
    font: 500 14.5px/1 var(--font-sans);
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: color 0.15s var(--bn-ease-theme);
  }

  .bn-blog:hover {
    color: var(--v5-ink);
  }

  .bn-end {
    display: flex;
    align-items: center;
    gap: var(--bn-gap);
  }

  /* The <nav> is a popover only for the phone sheet: here it is the bar's row. */
  .bn-row {
    position: static;
    inset: auto;
    display: flex;
    align-items: center;
    gap: var(--bn-gap);
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    overflow: visible;
    border: 0;
    background: none;
    color: inherit;
  }

  .bn-a,
  .bn-tg {
    display: inline-flex;
    align-items: center;
    padding-block: 15px;
    border-radius: 6px;
    color: var(--v5-ink-2);
    font: 500 14.5px/1 var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s var(--bn-ease-theme);
  }

  .bn-a:hover,
  .bn-tg:hover {
    color: var(--v5-ink);
  }

  .bn-dd {
    display: flex;
    align-items: center;
  }

  .bn-tg {
    gap: 6px;
    margin: 0;
    padding-inline: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .bn-dd--products > .bn-tg {
    anchor-name: --bn-products;
  }

  .bn-dd--lang > .bn-tg {
    anchor-name: --bn-lang;
  }

  .bn-chev {
    display: block;
    flex: none;
    margin-top: 1px;
    transition: rotate 0.2s var(--bn-ease);
  }

  .bn-globe {
    display: block;
    flex: none;
  }

  .bn-dd:has(> .bn-pop:popover-open) > .bn-tg {
    color: var(--v5-ink);
  }

  .bn-dd:has(> .bn-pop:popover-open) .bn-chev {
    rotate: 180deg;
  }

  /* The CTA: the home's lime button at the bar's size (36px high). */
  .bn-cta {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0 16px;
    border-radius: 8px;
    background: var(--bn-lime);
    color: var(--v5-ink);
    font: 500 14.5px/1 var(--font-sans);
    letter-spacing: -0.005em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s var(--bn-ease-theme);
  }

  .bn-cta:hover {
    background: #d6fba6;
  }

  /* The panels: paper cards, the bar's 1px edge and shadow family, r12. Hidden unless open. */
  .bn-pop {
    display: none;
    position: fixed;
    inset: auto;
    top: calc(var(--bn-h) + 9px); /* no anchor positioning: 8px under the bar and its 1px rule */
    right: var(--blog-gutter);
    width: auto;
    height: auto;
    margin: 0;
    padding: 8px;
    overflow: visible;
    border: 1px solid rgb(22 24 21 / 0.12);
    border-radius: 12px;
    background: var(--v5-paper);
    color: var(--v5-ink);
    box-shadow:
      0 1px 2px rgb(22 24 21 / 0.06),
      0 18px 40px -18px rgb(22 24 21 / 0.3);
    font: 400 15px/1.4 var(--font-sans);
    text-align: left;
  }

  .bn-pop:popover-open {
    display: block;
  }

  .bn-pop--products {
    width: 464px;
    max-width: calc(100% - 32px);
  }

  .bn-pop--lang {
    width: 216px;
  }

  @supports (anchor-name: --bn-a) {
    .bn-pop {
      top: calc(anchor(--bn-bar bottom) + 8px);
    }

    .bn-pop--products {
      right: auto;
      left: clamp(16px, anchor(--bn-products left) - 20px, 100% - 480px);
    }

    .bn-pop--lang {
      right: max(16px, anchor(--bn-lang right) - 20px);
    }
  }

  /* The list headings show in the phone sheet; elsewhere they only name the lists. */
  .bn-pop-h {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .bn-prods,
  .bn-langs {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bn-prod {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    grid-template-areas:
      "tile name host"
      ". line line";
    column-gap: 12px;
    row-gap: 4px;
    align-items: center;
    padding: 12px;
    border-radius: 8px;
    color: var(--v5-ink);
    text-decoration: none;
    transition: background-color 0.15s var(--bn-ease-theme);
  }

  .bn-prod:hover {
    background: var(--v5-frame);
  }

  .bn-prod:focus-visible {
    outline-offset: -2px;
  }

  .bn-tile {
    grid-area: tile;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: var(--bn-lime);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.05);
    color: var(--v5-ink);
  }

  .bn-tile-g {
    display: block;
    width: 12px;
    height: 12px;
  }

  .bn-prod-name {
    grid-area: name;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font: 500 15px/20px var(--font-sans);
    white-space: nowrap;
  }

  .bn-prod-host {
    grid-area: host;
    color: var(--v5-ink-2);
    font: 400 12px/20px var(--font-mono);
    letter-spacing: 0;
  }

  /* No orphaned last word, and ja breaks at phrases (as the home's lines). */
  .bn-prod-line {
    grid-area: line;
    color: var(--v5-ink-2);
    font: 400 14px/20px var(--font-sans);
    text-wrap: pretty;
  }

  .bn-prod-line:lang(ja) {
    word-break: auto-phrase;
  }

  .bn-new {
    display: inline-flex;
    flex: none;
    align-items: center;
    height: 18px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--bn-lime);
    color: var(--v5-ink);
    font: 600 10px/1 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bn-langs a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 8px;
    color: var(--v5-ink-2);
    font: 500 15px/20px var(--font-sans);
    text-decoration: none;
    transition:
      background-color 0.15s var(--bn-ease-theme),
      color 0.15s var(--bn-ease-theme);
  }

  .bn-langs a:hover {
    background: var(--v5-frame);
    color: var(--v5-ink);
  }

  .bn-langs a:focus-visible {
    outline-offset: -2px;
  }

  .bn-langs a[aria-current="true"] {
    color: var(--v5-ink);
  }

  .bn-check {
    display: block;
    flex: none;
    visibility: hidden;
  }

  .bn-langs a[aria-current="true"] .bn-check {
    visibility: visible;
  }

  .bn-menu {
    display: none;
  }

  @media (max-width: 1023px) {
    .bn {
      --bn-gap: 20px;
    }
  }

  /* Up to 860px, as on the home: logo / Blog and the menu button; the button opens the sheet under the bar: Products,
     Back to mosoo and RSS, the language (three segments) and the CTA. */
  @media (max-width: 860px) {
    .bn {
      --bn-h: 56px;
    }

    .bn-end {
      gap: 8px;
    }

    .bn-menu {
      display: grid;
      flex: none;
      place-items: center;
      width: 44px;
      height: 44px;
      margin: 0 -14px 0 0; /* the two lines, not the 44px box, end at the text edge */
      padding: 0;
      border: 0;
      border-radius: 8px;
      background: none;
      color: var(--v5-ink);
      cursor: pointer;
    }

    .bn-burger {
      display: block;
    }

    .bn-burger path {
      transform-origin: 9px 9px;
      transition: transform 0.2s var(--bn-ease);
    }

    .bn-end:has(.bn-row:popover-open) .bn-burger-a {
      transform: translateY(2.75px) rotate(45deg);
    }

    .bn-end:has(.bn-row:popover-open) .bn-burger-b {
      transform: translateY(-2.75px) rotate(-45deg);
    }

    /* At most 420px wide from the text edge: the bar's width on phones, a menu-sized card on tablets. Its place and
       look sit on the element and only display follows the open state (the home's rule): while it fades out it stays
       in the top layer for 150ms, and with its place tied to :popover-open it would drop back into the bar. */
    .bn-row {
      position: fixed;
      inset: auto;
      top: calc(var(--bn-h) + 9px);
      left: max(var(--blog-gutter), 100% - var(--blog-gutter) - 420px);
      right: var(--blog-gutter);
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      max-height: calc(100dvh - var(--bn-h) - 33px);
      padding: 8px;
      overflow: auto;
      overscroll-behavior: contain;
      border: 1px solid rgb(22 24 21 / 0.12);
      border-radius: 12px;
      background: var(--v5-paper);
      color: var(--v5-ink);
      box-shadow:
        0 1px 2px rgb(22 24 21 / 0.06),
        0 18px 40px -18px rgb(22 24 21 / 0.3);
    }

    .bn-row:popover-open {
      display: flex;
    }

    .bn-dd {
      display: block;
    }

    .bn-tg {
      display: none;
    }

    /* In the sheet the panels sit in the flow, shown whenever the sheet is. */
    .bn-row .bn-pop {
      position: static;
      display: block;
      width: auto;
      max-width: none;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
    }

    .bn-pop-h {
      position: static;
      display: flex;
      align-items: center;
      gap: 8px;
      width: auto;
      height: auto;
      margin: 0;
      padding: 10px 12px 6px;
      overflow: visible;
      clip-path: none;
      color: var(--v5-ink);
      font: 500 14px/20px var(--font-sans);
    }

    .bn-dd--products {
      margin-bottom: 8px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--v5-line);
    }

    .bn-dd--lang {
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px solid var(--v5-line);
    }

    .bn-prod {
      grid-template-columns: 20px minmax(0, 1fr);
      grid-template-areas:
        "tile name"
        ". line"
        ". host";
      row-gap: 2px;
    }

    .bn-prod-line {
      margin-top: 2px;
    }

    .bn-a {
      min-height: 44px;
      padding: 12px;
      border-radius: 8px;
