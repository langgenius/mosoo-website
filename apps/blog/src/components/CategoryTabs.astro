---
import { categoryLabel, indexCopyByLocale } from "../lib/copy.mjs";

interface Props {
  categories: readonly string[];
  locale?: "en" | "zh" | "ja";
  active?: string;
}

const { categories, locale = "en", active = "All" } = Astro.props;
const all = ["All", ...categories];
const copy = indexCopyByLocale[locale] ?? indexCopyByLocale.en;
---

<div
  class="flex flex-wrap items-center gap-2 overflow-x-auto"
  data-category-tabs
>
  {
    all.map((c) => (
      <button
        type="button"
        data-category={c}
        aria-pressed={c === active ? "true" : "false"}
        class="rounded-full border border-[color:var(--border)] bg-transparent px-3.5 py-1.5 text-[13px] font-medium tracking-[-0.01em] text-[color:var(--fg-secondary)] transition-colors duration-150 hover:border-[color:var(--border-strong)] hover:text-[color:var(--fg)] aria-pressed:border-[color:var(--ink-900)] aria-pressed:bg-[color:var(--ink-900)] aria-pressed:text-white aria-pressed:hover:border-[color:var(--ink-800)] aria-pressed:hover:bg-[color:var(--ink-800)] aria-pressed:hover:text-white"
      >
        {c === "All" ? copy.all : categoryLabel(locale, c)}
      </button>
    ))
  }
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "[data-category-tabs] [data-category]",
  );
  const cards = document.querySelectorAll<HTMLElement>("[data-card]");
  const select = (category: string): void => {
    buttons.forEach((b) => {
      const isActive = b.dataset.category === category;
      b.setAttribute("aria-pressed", isActive ? "true" : "false");
    });
    cards.forEach((c) => {
      c.style.display =
        category === "All" || c.dataset["category"] === category ? "" : "none";
    });
  };
  buttons.forEach((b) =>
    b.addEventListener("click", () => select(b.dataset.category ?? "All")),
  );
</script>
