---
// The blog's language switch: every language in sight, never behind a menu (owner 2026-10-20 17:15 「多语言切换不明显」;
// staging v5/polish/verify-visual.md §0 no. 1: a menu on wide screens and only inside the phone sheet was a step
// back). Drawn as the home footer's control (apps/landing/src/home/sections/footer.{ts,css} .v5-ft-lang): a globe,
// then this page in each language it exists in, as real links with hreflang and lang, the current one raised on paper.
// No 1px frame (design review, staging committee/MINUTES.md §2.4 no. 7): the 3% ink slot and the raised current
// segment carry it, so the current language differs by more than its colour (WCAG 1.4.1). The header shows it on the
// bar (short names, as the home bar's: EN / 中文 / 日本語), the footer under the posts (English / 简体中文 / 日本語, as
// the home footer's). A pick is remembered as the home remembers it (shared/locale.ts rememberLocale: the
// mosoo_locale cookie the worker's "/" redirect reads before Accept-Language); the links work without the script.
// Sizes come from the caller through custom properties: --ls-h (segment height), --ls-pad (segment side padding),
// --ls-globe (display of the globe). `compact`: under 400px the segments show the initials EN / 中 / 日 (the
// full name stays the link's text for screen readers and voice control, WCAG 2.5.3).
import { getLocaleOptions, localeInitials, localeNames, navCopyByLocale, type Locale } from "../lib/i18n";

interface Props {
  /** The languages this page exists in; all of them when not given (the index pages). */
  availableLocales?: Locale[];
  /** "short": EN / 中文 / 日本語 (the home bar's names); "native": English / 简体中文 / 日本語 (its footer's). */
  names: "short" | "native";
  /** Initials under 400px (the bar beside the phone menu button). */
  compact?: boolean;
}

const { availableLocales, names, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const options = getLocaleOptions(Astro.url.pathname, base).filter(
  ({ locale }) => !availableLocales || availableLocales.includes(locale),
);
const current = options.find(({ active }) => active)?.locale ?? "en";
const langTags: Record<Locale, string> = { en: "en", zh: "zh-CN", ja: "ja" };
// A page in one language has nothing to switch to.
const show = options.length > 1;
---

{
  show && (
    <div class:list={["ls", { "ls--compact": compact }]}>
      <svg
        class="ls-globe"
        viewBox="0 0 16 16"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="8" cy="8" r="6.4" />
        <path d="M1.6 8h12.8M8 1.6c1.7 1.8 2.6 4 2.6 6.4S9.7 12.6 8 14.4C6.3 12.6 5.4 10.4 5.4 8S6.3 3.4 8 1.6z" />
      </svg>
      <ul class="ls-list" aria-label={navCopyByLocale[current].changeLanguage}>
        {options.map((option) => (
          <li>
            <a
              href={option.href}
              hreflang={langTags[option.locale]}
              lang={langTags[option.locale]}
              data-locale={option.locale}
              aria-current={option.active ? "true" : undefined}
            >
              <span class="ls-name">{names === "native" ? localeNames[option.locale] : option.label}</span>
              {compact && (
                <span class="ls-initial" aria-hidden="true">
                  {localeInitials[option.locale]}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<script>
  // One listener for every switch on the page (the bar's and the footer's), as the home's nav engine does it.
  import { isLocale, rememberLocale } from "../../../landing/src/shared/locale.ts";

  document.addEventListener("click", (event) => {
    const link = event.target instanceof Element ? event.target.closest("a[data-locale]") : null;
    const code = link?.getAttribute("data-locale") ?? "";
    if (isLocale(code)) rememberLocale(code);
  });
</script>

<style>
  .ls {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--v5-ink);
  }

  .ls-globe {
    display: var(--ls-globe, block);
    flex: none;
  }

  .ls-list {
    display: flex;
    margin: 0;
    padding: 3px;
    list-style: none;
    border-radius: 10px;
    background: rgb(22 24 21 / 0.03);
  }

  .ls-list a {
    display: flex;
    align-items: center;
    min-height: var(--ls-h, 32px);
    padding: 0 var(--ls-pad, 12px);
    border-radius: 7px;
    color: var(--v5-ink-2);
    font: 500 14px/20px var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ls-list a:hover {
    color: var(--v5-ink);
  }

  .ls-list a:focus-visible {
    outline-offset: -2px;
  }

  .ls-list a[aria-current="true"] {
    background: var(--v5-paper);
    color: var(--v5-ink);
    box-shadow:
      0 0 0 1px rgb(22 24 21 / 0.08),
      0 1px 2px rgb(22 24 21 / 0.08);
  }

  .ls-initial {
    display: none;
  }

  @media (max-width: 399px) {
    .ls--compact .ls-name {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .ls--compact .ls-initial {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ls-list a {
      transition: none;
    }
  }
</style>
