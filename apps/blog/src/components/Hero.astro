---
import CardVisual from "./CardVisual.astro";
import CoverControls from "./CoverControls.astro";
import { getCover } from "../covers/registry";
import { getPostHref } from "../lib/i18n";
import { categoryLabel, dateLocaleByLocale } from "../lib/copy.mjs";
import type { CollectionEntry } from "astro:content";

interface Props {
  featured: CollectionEntry<"blog">;
  base: string;
  locale?: "en" | "zh" | "ja";
}
const { featured, base, locale = "en" } = Astro.props;
const href = getPostHref(featured, base);
const dateLabel = featured.data.date.toLocaleDateString(dateLocaleByLocale[locale] ?? "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const displayCategory = categoryLabel(locale, featured.data.category);
// Live-cover controls are rendered in an overlay that mirrors the grid below, so
// they sit on the visual without living inside the link.
const liveCover = getCover(featured.data.heroCover);
const coverUid = `cover-featured-${featured.id}`;
---

<div class="cv-card relative" data-cover-zone={liveCover ? "" : undefined}>
<a href={href} class="group block">
  <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-[0.95fr_1.05fr] lg:gap-12">
    <div class="overflow-hidden rounded-[var(--r-xl)] border border-[color:var(--border)] md:order-2">
      <CardVisual
        slug={featured.id}
        heroImage={featured.data.heroImage}
        heroAlt={featured.data.heroAlt ?? featured.data.title}
        heroCover={featured.data.heroCover}
        coverUid={coverUid}
        eager
        ratio="16/9"
      />
    </div>
    <div class="flex min-w-0 flex-col gap-4 md:order-1">
      <div class="flex items-center gap-2 text-[13px] text-[color:var(--fg-muted)]">
        <span class="font-semibold text-[color:var(--accent-text)]">{displayCategory}</span>
        <span aria-hidden="true">·</span>
        <time datetime={featured.data.date.toISOString()}>{dateLabel}</time>
      </div>
      <h2 class="font-display text-[30px] font-medium leading-[1.1] tracking-[-0.02em] text-[color:var(--ink-950)] underline decoration-transparent decoration-2 underline-offset-4 transition-[text-decoration-color] duration-200 group-hover:decoration-[color:var(--green-500)] md:text-[38px]">
        {featured.data.title}
      </h2>
      <p class="max-w-[52ch] text-[16px] leading-[1.6] text-[color:var(--fg-secondary)]">
        {featured.data.description}
      </p>
      <div class="mt-2 text-[14px] font-medium text-[color:var(--fg-secondary)]">
        {featured.data.author}
      </div>
    </div>
  </div>
</a>
{
  liveCover && (
    <div class="pointer-events-none absolute inset-0 grid h-full grid-cols-1 items-center gap-8 md:grid-cols-[0.95fr_1.05fr] lg:gap-12">
      <div class="relative aspect-[16/9] self-start md:order-2 md:self-center">
        <CoverControls cover={liveCover.id} uid={coverUid} locale={locale} compact class="pointer-events-auto absolute left-2.5 top-2.5" />
      </div>
      <div class="hidden md:order-1 md:block" />
    </div>
  )
}
</div>
