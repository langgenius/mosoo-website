---
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";
import CategoryTabs from "./CategoryTabs.astro";
import { CATEGORIES } from "../content.config";
import { getPostHref, type Locale } from "../lib/i18n";
import { indexCopyByLocale } from "../lib/copy.mjs";
import "../styles/index-cards.css";

interface Props {
  posts: CollectionEntry<"blog">[];
  base: string;
  locale?: Locale;
  eyebrow: string;
  title?: string;
  description?: string;
}

const { posts, base, locale = "en", eyebrow } = Astro.props;
const copy = indexCopyByLocale[locale] ?? indexCopyByLocale.en;
const title = Astro.props.title ?? copy.title;
const description = Astro.props.description ?? copy.description;
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const categories = CATEGORIES.filter((category) =>
  posts.some((post) => post.data.category === category),
);
---

<main data-page data-blog-index>
  <section class="blog-wrap bi-masthead">
    <p class="bi-eyebrow">{eyebrow}</p>
    <h1 class="bi-title">{title}</h1>
    <p class="bi-lede">{description}</p>
  </section>

  {
    featured && (
      <section class="blog-wrap bi-lead">
        <Card post={featured} href={getPostHref(featured, base)} locale={locale} variant="lead" />
      </section>
    )
  }

  <section class="blog-wrap bi-all" aria-labelledby="bi-all-posts">
    <div class="bi-all-head">
      <h2 id="bi-all-posts" class="bi-h2">{copy.allPosts}</h2>
      <span class="bi-count">
        {posts.length} {posts.length === 1 ? copy.post : copy.posts}
      </span>
    </div>

    <CategoryTabs categories={categories} locale={locale} />

    <div class="bi-grid">
      {posts.map((post) => <Card post={post} href={getPostHref(post, base)} locale={locale} />)}
    </div>

    {posts.length === 0 && <p class="bi-empty">{copy.empty}</p>}
  </section>
</main>

<script>
  // Card entrance: the landing's v5 rise engine (data-rise="card": Intent's 120px / 700 ms /
  // cubic-bezier(.25, 1, .5, 1), cards entering together 100 ms apart). It hides only cards that start
  // below the fold, and does nothing under prefers-reduced-motion; without JS every card is visible.
  import { initRise } from "../../../landing/src/effects/v5/rise.ts";

  initRise();
</script>
